generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SHADOW_DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  firstname String
  lastname  String
  password  String
  role Role @relation(fields: [role_id], references: [id])
  role_id Int

}

model Role {
  id       Int  @id @default(autoincrement())
  name    String @unique
  users User[]
}