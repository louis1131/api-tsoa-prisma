{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Louis",
  "license": "MIT",
  "scripts": {
    "build": "npx tsoa spec-and-routes && tsc",
    "start": "node build/server.js",
    "prepare-prod": "yarn prisma generate && yarn prisma migrate deploy && yarn prisma db seed && yarn tsoa routes && yarn build",
    "dev": "nodemon --watch src --ignore src/routes.ts --ext ts,json --exec \"npx tsoa routes && ts-node src/server.ts\"",
    "swagger": "tsoa spec"
  },
  "prisma": {
    "seed": "yarn ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "argon2": "^0.44.0",
    "disposable-email-domains-js": "^1.21.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "resend": "^6.9.1",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.1.0",
    "@types/nodemailer": "^7.0.9",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.11",
    "prisma": "6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
